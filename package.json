{
  "name": "tellerline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "registry:build": "shadcn build",
    "registry:check": "shadcn build && git diff --exit-code -- public/r",
    "smoke": "bash scripts/smoke-install.sh"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "license": "MIT",
  "description": "Accessible React components for banking and back-office apps, installed with the shadcn CLI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aranshayan/tellerline"
  }
}
